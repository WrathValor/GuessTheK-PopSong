# Copy this file to .env (same folder) and fill it in. .env is git-ignored: never commit it.

# Discord: discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Roblox Open Cloud API key (create.roblox.com → Open Cloud → API Keys), made on the ALT:
#   Access permissions: Assets API → Read + Write
#   Group: 430052409 (the key must belong to an account that can upload to the group)
ROBLOX_API_KEY=
ROBLOX_GROUP_ID=430052409

# Your Discord user id (Discord settings → Advanced → Developer Mode, then right-click your
# name → Copy User ID). Only these ids can use the bot; separate several with commas.
ALLOWED_USERS=

# Your server's id (right-click the server icon → Copy Server ID). The slash commands show up
# there straight away; leave it empty and they're global, which can take up to an hour at first.
GUILD_ID=

# Optional: the repo folder (defaults to two folders up from this file)
REPO_ROOT=
